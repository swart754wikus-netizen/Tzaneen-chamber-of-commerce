rules_version = '2';

// Content everyone can read (events, directory, Exco, document titles) is
// only ever writable by a signed-in admin. Public forms (RSVPs, membership
// applications) can only be created, never read/edited/deleted, by the
// public — only the signed-in admin can list or export them.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /rsvps/{rsvpId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
      }
    }

    match /applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /excoMembers/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
